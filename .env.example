# ============================================
# Execution Bot — Webhook-Driven Trade Execution
# Receives trade signals via HTTP webhook, executes through Tradovate API.
# No internal strategies, no market data feed, no indicators.
# ============================================
# Copy this file to .env and fill in your credentials.
# ============================================

# === TRADOVATE CREDENTIALS ===
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=your_username
TRADOVATE_PASSWORD=your_password
TRADOVATE_CID=your_client_id
TRADOVATE_SECRET=your_api_secret
TRADOVATE_ACCOUNT_NAME=your_account_name

# === CONTRACT ===
CONTRACT_SYMBOL=MNQU6
AUTO_ROLLOVER=false

# === SESSION (PST — futures session) ===
TRADING_START_HOUR=6
TRADING_START_MINUTE=30
TRADING_END_HOUR=13
TRADING_END_MINUTE=0
AVOID_LUNCH=false
TIMEZONE=America/Los_Angeles
LAST_ENTRY_HOUR=12
LAST_ENTRY_MINUTE=30

# === RISK MANAGEMENT ===
RISK_PER_TRADE_MIN=10
RISK_PER_TRADE_MAX=60
MAX_CONTRACTS=3
PROFIT_TARGET_R=2.5
MIN_STOP_POINTS=4

# === LOSS LIMITS ===
DAILY_LOSS_LIMIT=150
WEEKLY_LOSS_LIMIT=400
MAX_CONSECUTIVE_LOSSES=3
MAX_DRAWDOWN_PERCENT=15
DAILY_PROFIT_TARGET=700
DAILY_PROFIT_TIERS=100:50,200:150,300:250,400:350,500:450,600:550,700:650

# === MAX TRADES PER DAY ===
MAX_TRADES_PER_DAY=3

# === DISABLE THURSDAY (optional) ===
# DISABLE_THURSDAY=true

# === NOTIFICATIONS ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === WEBHOOK SERVER ===
WEBHOOK_ENABLED=true
WEBHOOK_PORT=8787
WEBHOOK_TOKEN=generate_a_random_string_of_at_least_32_characters
MAX_WEBHOOK_QTY=2
MAX_WEBHOOK_STOP_TICKS=200
WEBHOOK_DEDUP_MS=300000

# Resting-entry auto-cancel windows (seconds).
# A Stop entry waits on a break that can take several bars, so it gets longer.
# Overridable per-signal with --entry-timeout.
LIMIT_ENTRY_TIMEOUT_SEC=180
STOP_ENTRY_TIMEOUT_SEC=900

# ============================================
# Tradovate MNQ Trading Bot — Production Config V2.10 (Multi-TF PB)
# Strategy: MNQ Momentum V2 (PB 5m + PB 3m + PB 2m, VR disabled)
# Session: 6:30 AM - 1:00 PM PST (America/Los_Angeles)
# Data: Databento ohlcv-1m → 1-min bars → 2m/3m/5m bars
# AI: OFF | Trailing: OFF | Partials: OFF
# BE Stop: ON @ 1.2R activation | Max Contracts: 3
#
# Active sub-strategies:
#   PB 5m: Momentum pullback on 5m bars, imp 15-40pt, 3-bar lookback, market entry
#   PB 3m: Momentum pullback on 3m bars, imp 10-30pt, 3-bar lookback
#   PB 2m: Momentum pullback on 2m bars, imp 8-25pt, 3-bar lookback
#   VR: DISABLED
#   EMAX: DISABLED
#
# Copy this file to .env and fill in your credentials.
# ============================================

# === TRADOVATE CREDENTIALS ===
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=your_username
TRADOVATE_PASSWORD=your_password
TRADOVATE_CID=your_client_id
TRADOVATE_SECRET=your_api_secret
TRADOVATE_ACCOUNT_NAME=your_account_name

# === SESSION (PST — MNQ futures session) ===
TRADING_START_HOUR=6
TRADING_START_MINUTE=30
TRADING_END_HOUR=13
TRADING_END_MINUTE=0
AVOID_LUNCH=false
TIMEZONE=America/Los_Angeles

# === DATABENTO (Market Data Provider) ===
DATABENTO_API_KEY=your_databento_api_key
DATABENTO_SYMBOL=MNQ.FUT
DATABENTO_SCHEMA=ohlcv-1m
DATABENTO_DATASET=GLBX.MDP3
PYTHON_PATH=python

# === SLIPPAGE GUARD (Tick Stream) ===
TICK_STREAM_ENABLED=true

# === POST-RECONNECT COOLDOWN ===
# Minutes to suppress new signals after Databento reconnects with ≥3 bars dropped.
# Allows indicators (RSI, ATR, 5m bars) to rebuild on fresh live data.
POST_RECONNECT_COOLDOWN_MINS=10
POST_RECONNECT_MIN_DROPPED_BARS=3

# === NOTIFICATIONS ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === AI (DISABLED — costs P&L, blocks winners) ===
AI_CONFIRMATION_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key
AI_MODEL=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=40
AI_TIMEOUT=8000
AI_DEFAULT_ACTION=confirm

# ---------------------------------------------------------------
#  MULTI-INSTRUMENT MODE — MNQ ONLY
# ---------------------------------------------------------------
INSTRUMENTS=MNQ

# -- MNQ — Momentum Pullback V2.6 (Production) --
# Contract
MNQ_SYMBOL=MNQM6
MNQ_STRATEGY=mnq_momentum_v2
MNQ_DATABENTO_SYMBOL=MNQ.FUT
MNQ_AUTO_ROLLOVER=false

# Risk management
MNQ_RISK_PER_TRADE_MIN=10
MNQ_RISK_PER_TRADE_MAX=60
MNQ_MAX_CONTRACTS=3
MNQ_DAILY_LOSS_LIMIT=150
MNQ_WEEKLY_LOSS_LIMIT=400
MNQ_MAX_CONSECUTIVE_LOSSES=3
MNQ_MAX_DRAWDOWN_PERCENT=15
MNQ_MAX_LOSSES_PER_DAY=3
MNQ_DAILY_PROFIT_TARGET=750
MNQ_DAILY_PROFIT_TIERS=100:50,200:150,300:250,400:350,500:450,600:550,700:650

# Session
MNQ_LAST_ENTRY_HOUR=13
MNQ_LAST_ENTRY_MINUTE=0

# EMAX sub-strategy (DISABLED)
MNQ_EMAX_ENABLED=false

# PB sub-strategy (Momentum Pullback on 5m bars)
MNQ_PB_MIN_IMPULSE=15
MNQ_PB_MAX_IMPULSE=40
MNQ_PB_MIN_IMP_BODY_RATIO=0.15
MNQ_PB_RETRACE_MIN=0.10
MNQ_PB_RETRACE_MAX=0.85
MNQ_PB_MAX_TIME=780
MNQ_PB_LOOKBACK_BARS=3

# PB Entry Timing (V2.11 — always market entry, tick-triggered intra-bar)
MNQ_PB_ENTRY_MODE=immediate
MNQ_PB_CONFIRM_BARS=5
MNQ_PB_LIMIT_RETRACE_PCT=0.6
MNQ_PB_LIMIT_TIMEOUT_BARS=5
MNQ_PB_TREND_FILTER=false

# Tick-triggered entry (intra-bar evaluation via real-time Databento trade prints)
# When true: arms on impulse detection, enters on first qualifying tick in retrace zone
# When false: legacy bar-close entry (waits for pullback bar to complete)
MNQ_PB_TICK_ENTRY=true
MNQ_PB3M_TICK_ENTRY=true
MNQ_PB2M_TICK_ENTRY=true

# Post-trade cooldown (1m bars to wait after trade closes before next signal)
MNQ_COOLDOWN_BARS=6

# PB 3m sub-strategy (Momentum Pullback on 3m bars)
MNQ_PB3M_ENABLED=true
MNQ_PB3M_MIN_IMPULSE=10
MNQ_PB3M_MAX_IMPULSE=30
MNQ_PB3M_LOOKBACK_BARS=3
MNQ_PB3M_MAX_TIME=780
MNQ_PB3M_RETRACE_MIN=0.10
MNQ_PB3M_RETRACE_MAX=0.85
MNQ_PB3M_MIN_IMP_BODY_RATIO=0.15
MNQ_PB3M_MAX_STOP_POINTS=30
MNQ_PB3M_MIN_STOP_POINTS=3
MNQ_PB3M_MIN_TARGET_POINTS=15

# PB 2m sub-strategy (Momentum Pullback on 2m bars)
MNQ_PB2M_ENABLED=true
MNQ_PB2M_MIN_IMPULSE=8
MNQ_PB2M_MAX_IMPULSE=25
MNQ_PB2M_LOOKBACK_BARS=3
MNQ_PB2M_MAX_TIME=780
MNQ_PB2M_RETRACE_MIN=0.10
MNQ_PB2M_RETRACE_MAX=0.85
MNQ_PB2M_MIN_IMP_BODY_RATIO=0.15
MNQ_PB2M_MAX_STOP_POINTS=20
MNQ_PB2M_MIN_STOP_POINTS=2
MNQ_PB2M_MIN_TARGET_POINTS=10

# VR sub-strategy (DISABLED — shorts are net losers, PB multi-TF replaces it)
MNQ_VR_ENABLED=false
MNQ_VR_MIN_TIME=510
MNQ_VR_MAX_TIME=660
MNQ_VR_MIN_SIGMA=1.3
MNQ_VR_ENTRY_SIGMA_MAX=1.0
MNQ_VR_STOP_BEYOND_BAND=3
MNQ_VR_TARGET_MODE=fixed
MNQ_VR_TARGET_R=4
MNQ_VR_MIN_BAR_VOL_RATIO=0.8
MNQ_VR_MAX_STOP_POINTS=20
MNQ_VR_MIN_STOP_POINTS=4
MNQ_VR_COOLDOWN_BARS=10

# Slippage guard (max adverse pts before rejecting market entry)
# Global default — used if no per-strategy override is set
MNQ_MAX_ENTRY_SLIPPAGE_PTS=5
# Per-strategy overrides (tighter for faster timeframes, wider for slower)
MNQ_PB_MAX_ENTRY_SLIPPAGE_PTS=5
MNQ_PB3M_MAX_ENTRY_SLIPPAGE_PTS=4
MNQ_PB2M_MAX_ENTRY_SLIPPAGE_PTS=3
MNQ_VR_MAX_ENTRY_SLIPPAGE_PTS=5
MNQ_EMAX_MAX_ENTRY_SLIPPAGE_PTS=5

# Shared stop/target
MNQ_MAX_STOP_POINTS=35
MNQ_MIN_STOP_POINTS=5
MNQ_STOP_BUFFER=2
MNQ_PROFIT_TARGET_R=2.5
MNQ_MIN_TARGET_POINTS=20
MNQ_MIN_CONFLUENCE=0

# Order management
MNQ_MOVE_STOP_TO_BE=true
MNQ_BE_ACTIVATION_R=1.2
# Stop ladder: triggerR:placementR pairs, comma-separated. Overrides MOVE_STOP_TO_BE/BE_ACTIVATION_R when set.
# placementR=0 → breakeven (+1pt offset); negative → below entry; positive → above entry.
# All stop prices are rounded to nearest 0.25 (MNQ tick size).
# Example: at 1R profit move stop to -0.5R, at 2R to +0.5R, at 3R to +1.5R
MNQ_BE_STOP_STEPS=1.0:-0.5,2.0:0.5,3.0:1.5
MNQ_PARTIAL_PROFIT_ENABLED=false
MNQ_TRAILING_STOP_ENABLED=false

# Volume Filter (Monte Carlo validated: filters low-volume signals, reduces DD ~40%)
MNQ_VOLUME_FILTER_ENABLED=true
MNQ_VOLUME_FILTER_MIN=0.9
MNQ_VOLUME_FILTER_PERIOD=20
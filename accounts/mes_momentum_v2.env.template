# ═══════════════════════════════════════════════════════════════════════════
#  MES — Brooks Momentum-V2 book (PB + EPB + PDH/PDL-break + gap-day filter)
#  Risk locked at $135/trade. Backtest (Jun-2025→Jun-2026, parity replay):
#    0-tick entry slip: +$12,294/yr ($1,025/mo) PF 1.68
#    1-tick (realistic): +$9,911/yr  ($826/mo)  PF 1.53  DD $1,153  ← plan around this
#  All quarters green; Monte-Carlo 100% profitable (p5 +$4,630).
#  TO ACTIVATE: fill the credentials/telegram below, then rename to  <name>.env
#  (the loader only reads *.env, so this .template is inert until renamed).
#  If this account also trades M2K, add M2K back to INSTRUMENTS and re-add its block.
# ═══════════════════════════════════════════════════════════════════════════

# === TRADOVATE CREDENTIALS  (copy from your existing account .env) ===
TRADOVATE_ENV=live
TRADOVATE_USERNAME=your_username
TRADOVATE_PASSWORD=your_password
TRADOVATE_CID=your_cid
TRADOVATE_SECRET=your_secret
TRADOVATE_ACCOUNT_NAME=your_account_name

# === TELEGRAM (per account) ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === INSTRUMENTS ===
INSTRUMENTS=MES

# ── Instrument / contract ──
MES_SYMBOL=MESU6
MES_STRATEGY=mnq_momentum_v2
MES_DATABENTO_SYMBOL=MES.FUT
MES_AUTO_ROLLOVER=true

# ── Session (bot-level gate; strategy also hard-cuts at 10:30 PT via HARD_ENTRY_CUTOFF) ──
MES_LAST_ENTRY_HOUR=10
MES_LAST_ENTRY_MINUTE=30

# ── Risk (LOCKED $135/trade, 5-contract ceiling) ──
MES_RISK_PER_TRADE_MIN=5
MES_RISK_PER_TRADE_MAX=135
MES_MAX_CONTRACTS=5
MES_DAILY_LOSS_LIMIT=200
MES_WEEKLY_LOSS_LIMIT=5000
MES_MAX_CONSECUTIVE_LOSSES=5
MES_MAX_LOSSES_PER_DAY=5
MES_MAX_DRAWDOWN_PERCENT=25

# ── Disabled sub-strategies (only the Brooks pullback family trades) ──
MES_EMAX_ENABLED=false
MES_VR_ENABLED=false
MES_VOLUME_FILTER_ENABLED=false

# ── Brooks stop-entry (break of signal-bar extreme → synthetic stop-MARKET) ──
MES_STOP_ENTRY_ENABLED=true
MES_STOP_ENTRY_OFFSET_TICKS=1
MES_STOP_ENTRY_CANCEL_BARS=2
MES_ENTRY_ORDER_TYPE=Market
MES_PB_TICK_ENTRY=false
MES_PB3M_TICK_ENTRY=false
MES_PB2M_TICK_ENTRY=false
MES_CONSEC_TICKS_REQUIRED=6
MES_COOLDOWN_BARS=1

# ── Brooks signal-bar quality gates ──
MES_SIG_BAR_MAX_BODY_PCT=0.6
MES_SIG_BAR_MIN_TAIL_PCT=0.25
MES_SIG_BAR_MIN_CLOSE_LOC=0.5

# ── Impulse-pullback family (PB 5m / 3m / 2m). Impulses = MNQ ÷ 6.3 vol ratio ──
MES_PB_ENABLED=true
MES_PB_MIN_IMPULSE=2.5
MES_PB_MAX_IMPULSE=Infinity
MES_PB_MIN_IMP_BODY_RATIO=0.40
MES_PB_RETRACE_MIN=0.60
MES_PB_RETRACE_MAX=0.85
MES_PB_MAX_TIME=630
MES_PB_LOOKBACK_BARS=3
MES_PB_MIN_CONFLUENCE=5

MES_PB3M_ENABLED=true
MES_PB3M_MIN_IMPULSE=3.25
MES_PB3M_MAX_IMPULSE=19.0
MES_PB3M_MIN_IMP_BODY_RATIO=0.10
MES_PB3M_RETRACE_MIN=0.60
MES_PB3M_RETRACE_MAX=0.85
MES_PB3M_MAX_TIME=630
MES_PB3M_LOOKBACK_BARS=4
MES_PB3M_MAX_STOP_POINTS=6
MES_PB3M_MIN_STOP_POINTS=1
MES_PB3M_MIN_TARGET_POINTS=1.25
MES_PB3M_MIN_CONFLUENCE=5

MES_PB2M_ENABLED=true
MES_PB2M_MIN_IMPULSE=0.75
MES_PB2M_MAX_IMPULSE=12.75
MES_PB2M_MIN_IMP_BODY_RATIO=0.10
MES_PB2M_RETRACE_MIN=0.60
MES_PB2M_RETRACE_MAX=0.85
MES_PB2M_MAX_TIME=630
MES_PB2M_LOOKBACK_BARS=3
MES_PB2M_MAX_STOP_POINTS=6
MES_PB2M_MIN_STOP_POINTS=1
MES_PB2M_MIN_TARGET_POINTS=1.25
MES_PB2M_MIN_CONFLUENCE=5

# ── Brooks EMA-pullback (EPB) — with-trend pullback to the 20-EMA on 5m ──
MES_EMA_PB_ENABLED=true
MES_EMA_PB_TF=5m
MES_EMA_PB_PERIOD=20
MES_EMA_PB_SLOPE_LOOKBACK=3
MES_EMA_PB_LEG_LOOKBACK=15
MES_EMA_PB_TOUCH_TOL_ATR=0.25
MES_EMA_PB_MIN_LEG_ATR=1.0

# ── PDH/PDL break-continuation setup ──
MES_LB_ENABLED=true
MES_LB_REQUIRE_BIAS=false
MES_LB_TARGET_R=1.5
MES_LB_STOP_ATR=1.0

# ── Regime filters ──
MES_SKIP_DOWS=5
MES_HARD_ENTRY_CUTOFF=630
MES_GAP_SKIP_LO=-0.9
MES_GAP_SKIP_HI=-0.25
MES_GAP_ATR_PERIOD=14

# ── RANGE-REGIME book: RF edge-fade in flat-EMA well-formed ranges (all-day window,
#    fills until 12:50 PT; the flat-EMA gate IS the regime detector) ──
MES_RANGE_FADE_ENABLED=true
MES_RANGE_FADE_TF=5m
MES_RANGE_FADE_LOOKBACK=20
MES_RANGE_FADE_MAX_SLOPE_ATR=0.10
MES_RANGE_FADE_MIN_SIZE_ATR=1.5
MES_RANGE_FADE_MAX_SIZE_ATR=4.0
MES_RANGE_FADE_EDGE_PCT=0.15
MES_RANGE_FADE_TARGET_R=1.5
MES_RF_WIN_LO=390
MES_RF_WIN_HI=770

# ── Shared economics / exits ──
MES_MAX_STOP_POINTS=6
MES_MIN_STOP_POINTS=1
MES_MIN_TARGET_POINTS=1.25
MES_STOP_BUFFER=0.25
MES_PROFIT_TARGET_R=2.75
MES_MIN_CONFLUENCE=5
MES_MOMENTUM_BARS=3
MES_VOLUME_AVG_PERIOD=20
MES_PRIOR_LEVEL_TOLERANCE=0.75
MES_MOVE_STOP_TO_BE=false

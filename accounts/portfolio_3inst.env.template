# ═══════════════════════════════════════════════════════════════════════════
#  3-INSTRUMENT PORTFOLIO — MES (full regime book) + MYM + MNQ (LVLB-only)
#  M2K REMOVED (worst net/DD 0.70). Governance = ACCOUNT-LEVEL daily loss halt.
#  Backtest (full year, $135/trade, 1-tick slip, account halt $250):
#    +$12,448/yr ($1,037/mo) · maxDD $1,891 · net/DD 6.58 · ~1.9 trades/day
#  Fill credentials/telegram from your existing account .env, then rename to <name>.env
# ═══════════════════════════════════════════════════════════════════════════

# === CREDENTIALS (copy from existing account .env) ===
TRADOVATE_ENV=live
TRADOVATE_USERNAME=your_username
TRADOVATE_PASSWORD=your_password
TRADOVATE_CID=your_cid
TRADOVATE_SECRET=your_secret
TRADOVATE_ACCOUNT_NAME=your_account_name
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === PORTFOLIO ===
INSTRUMENTS=MES,MYM,MNQ
MAX_SIMULTANEOUS_POSITIONS=3
# ★ ACCOUNT-LEVEL daily loss halt (across ALL instruments). Per-instrument limits below
#   are set HIGH (effectively off) so THIS is the single governor — matches the backtest.
# Tightened 250->200 (2026-07-08): on 4-quarter MES+MNQ (168 days) $200 dominates $250 on
#   BOTH net (+$12,045 vs +$11,882) and DD ($1,350 vs $1,490), and has a smaller worst-day
#   in every train/test window (wins 4/5 windows on net/DD). Better max-P/L-min-DD tradeoff.
ACCOUNT_DAILY_LOSS_LIMIT=200


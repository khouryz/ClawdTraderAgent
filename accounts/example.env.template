# ============================================
# Account Template - Copy this to accountX.env and fill in your values
# ============================================

# === TRADOVATE CREDENTIALS ===
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=your_username
TRADOVATE_PASSWORD=your_password
TRADOVATE_CID=your_cid
TRADOVATE_SECRET=your_secret
TRADOVATE_ACCOUNT_NAME=your_account_name

# === TELEGRAM (PER-ACCOUNT) ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === INSTRUMENTS ===
INSTRUMENTS=MNQ

# === MNQ CONFIGURATION ===
MNQ_SYMBOL=MNQM6
MNQ_STRATEGY=mnq_momentum_v2
MNQ_DATABENTO_SYMBOL=MNQ.FUT
MNQ_AUTO_ROLLOVER=false

# === RISK MANAGEMENT ===
MNQ_RISK_PER_TRADE_MIN=15
MNQ_RISK_PER_TRADE_MAX=90
MNQ_MAX_CONTRACTS=5
MNQ_DAILY_LOSS_LIMIT=200
MNQ_WEEKLY_LOSS_LIMIT=650
MNQ_MAX_CONSECUTIVE_LOSSES=5
MNQ_MAX_DRAWDOWN_PERCENT=15
MNQ_MAX_LOSSES_PER_DAY=5

# === SESSION ===
MNQ_LAST_ENTRY_HOUR=10
MNQ_LAST_ENTRY_MINUTE=30
MNQ_SKIP_HOURS=7:00-7:14,9:15-9:29

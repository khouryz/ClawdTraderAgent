# ============================================
# Trend Pullback Strategy — Account Config
# Targets: 2-4 trades/day, 50% win rate, 2R target
# ============================================

# === TRADOVATE CREDENTIALS ===
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=your_username
TRADOVATE_PASSWORD=your_password
TRADOVATE_CID=your_client_id
TRADOVATE_SECRET=your_api_secret
TRADOVATE_ACCOUNT_NAME=your_account_name

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === PORTFOLIO ===
INSTRUMENTS=MNQ,MES
MAX_SIMULTANEOUS_POSITIONS=2
ACCOUNT_DAILY_LOSS_LIMIT=200
NATIVE_STOP_ENTRY=true

# === DATABENTO ===
DATABENTO_API_KEY=your_databento_api_key
DATABENTO_DATASET=GLBX.MDP3
PYTHON_PATH=python

# === SESSION (PST) ===
TIMEZONE=America/Los_Angeles
TRADING_START_HOUR=6
TRADING_START_MINUTE=30
TRADING_END_HOUR=13
TRADING_END_MINUTE=0

# ---------------------------------------------------------------
#  MNQ — Trend Pullback
# ---------------------------------------------------------------
MNQ_SYMBOL=MNQU6
MNQ_STRATEGY=trend_pullback
MNQ_DATABENTO_SYMBOL=MNQ.FUT
MNQ_AUTO_ROLLOVER=false
MNQ_LAST_ENTRY_HOUR=10
MNQ_LAST_ENTRY_MINUTE=30

# Risk
MNQ_RISK_PER_TRADE_MIN=10
MNQ_RISK_PER_TRADE_MAX=60
MNQ_MAX_CONTRACTS=3
MNQ_DAILY_LOSS_LIMIT=100000
MNQ_WEEKLY_LOSS_LIMIT=100000
MNQ_MAX_CONSECUTIVE_LOSSES=99
MNQ_MAX_LOSSES_PER_DAY=99
MNQ_MAX_DRAWDOWN_PERCENT=50

# EMA periods
MNQ_EMA_FAST_PERIOD=9
MNQ_EMA_MID_PERIOD=21
MNQ_EMA_SLOW_PERIOD=50

# ATR
MNQ_ATR_PERIOD=14
MNQ_ATR_STOP_MULT=1.5

# Stops / targets
MNQ_MAX_STOP_POINTS=60
MNQ_MIN_STOP_POINTS=5
MNQ_MIN_TARGET_POINTS=10
MNQ_STOP_BUFFER=2
MNQ_PROFIT_TARGET_R=2.0
MNQ_BE_ACTIVATION_R=1.0
MNQ_MOVE_STOP_TO_BE=true

# Pullback zone
MNQ_PULLBACK_ZONE_ATR=0.5

# Trade management
MNQ_COOLDOWN_BARS=2
MNQ_MAX_TRADES_PER_DAY=4
MNQ_TIME_STOP_BARS=12
MNQ_TIME_STOP_ENABLED=true

# Stop-entry
MNQ_STOP_ENTRY_OFFSET_TICKS=1
MNQ_STOP_ENTRY_CANCEL_BARS=3
MNQ_ENTRY_ORDER_TYPE=Market

# Filters
MNQ_RSI_FILTER_ENABLED=false
MNQ_SKIP_DOWS=5
MNQ_HARD_ENTRY_CUTOFF=630

# Slippage guard
MNQ_MAX_ENTRY_SLIPPAGE_PTS=5
MNQ_DEFERRED_ENTRY_WINDOW_SEC=60

# ---------------------------------------------------------------
#  MES — Trend Pullback
# ---------------------------------------------------------------
MES_SYMBOL=MESU6
MES_STRATEGY=trend_pullback
MES_DATABENTO_SYMBOL=MES.FUT
MES_AUTO_ROLLOVER=false
MES_LAST_ENTRY_HOUR=10
MES_LAST_ENTRY_MINUTE=30

# Risk
MES_RISK_PER_TRADE_MIN=10
MES_RISK_PER_TRADE_MAX=135
MES_MAX_CONTRACTS=5
MES_DAILY_LOSS_LIMIT=100000
MES_WEEKLY_LOSS_LIMIT=100000
MES_MAX_CONSECUTIVE_LOSSES=99
MES_MAX_LOSSES_PER_DAY=99
MES_MAX_DRAWDOWN_PERCENT=50

# EMA periods
MES_EMA_FAST_PERIOD=9
MES_EMA_MID_PERIOD=21
MES_EMA_SLOW_PERIOD=50

# ATR
MES_ATR_PERIOD=14
MES_ATR_STOP_MULT=1.5

# Stops / targets
MES_MAX_STOP_POINTS=15
MES_MIN_STOP_POINTS=2
MES_MIN_TARGET_POINTS=3
MES_STOP_BUFFER=0.25
MES_PROFIT_TARGET_R=2.0
MES_BE_ACTIVATION_R=1.0
MES_MOVE_STOP_TO_BE=true

# Pullback zone
MES_PULLBACK_ZONE_ATR=0.5

# Trade management
MES_COOLDOWN_BARS=2
MES_MAX_TRADES_PER_DAY=4
MES_TIME_STOP_BARS=12
MES_TIME_STOP_ENABLED=true

# Stop-entry
MES_STOP_ENTRY_OFFSET_TICKS=1
MES_STOP_ENTRY_CANCEL_BARS=3
MES_ENTRY_ORDER_TYPE=Market

# Filters
MES_RSI_FILTER_ENABLED=false
MES_SKIP_DOWS=5
MES_HARD_ENTRY_CUTOFF=630

# Slippage guard
MES_MAX_ENTRY_SLIPPAGE_PTS=3
MES_DEFERRED_ENTRY_WINDOW_SEC=60

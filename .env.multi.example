# ═══════════════════════════════════════════════════════════════
#  MULTI-INSTRUMENT BOT CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# To enable multi-instrument mode, set INSTRUMENTS and copy
# the relevant sections below into your .env file.
#
# Single-instrument mode (original TradovateBot) is used when
# INSTRUMENTS is NOT set.
# ═══════════════════════════════════════════════════════════════

# ── Global Settings (shared across all instruments) ──
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=your_username
TRADOVATE_PASSWORD=your_password
TRADOVATE_CID=your_cid
TRADOVATE_SECRET=your_secret

TIMEZONE=America/Los_Angeles
TRADING_START_HOUR=6
TRADING_START_MINUTE=30
TRADING_END_HOUR=13
TRADING_END_MINUTE=0

DATABENTO_API_KEY=your_databento_key
DATABENTO_DATASET=GLBX.MDP3
PYTHON_PATH=python

# AI (shared, currently disabled)
AI_CONFIRMATION_ENABLED=false

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Instrument List ──
INSTRUMENTS=MNQ,MES,M2K

# ═══════════════════════════════════════════════════════════════
#  MNQ — Momentum Pullback V2 (Production Config V2.5)
# ═══════════════════════════════════════════════════════════════
MNQ_SYMBOL=MNQH6
MNQ_STRATEGY=mnq_momentum_v2
MNQ_DATABENTO_SYMBOL=MNQ.FUT
MNQ_AUTO_ROLLOVER=true
MNQ_LAST_ENTRY_HOUR=11
MNQ_LAST_ENTRY_MINUTE=0

# Risk
MNQ_RISK_PER_TRADE_MIN=25
MNQ_RISK_PER_TRADE_MAX=60
MNQ_DAILY_LOSS_LIMIT=150
MNQ_WEEKLY_LOSS_LIMIT=500
MNQ_MAX_CONSECUTIVE_LOSSES=3
MNQ_MAX_DRAWDOWN_PERCENT=5

# EMAX (disabled — PF 0.65-0.87)
MNQ_EMAX_ENABLED=false

# PB (the edge)
MNQ_PB_MIN_IMPULSE=15
MNQ_PB_MIN_IMP_BODY_RATIO=0.15
MNQ_PB_RETRACE_MIN=0.15
MNQ_PB_RETRACE_MAX=0.75
MNQ_PB_MAX_TIME=570

# VR (VWAP Mean Reversion)
MNQ_VR_ENABLED=true
MNQ_VR_MIN_TIME=510
MNQ_VR_MAX_TIME=750
MNQ_VR_MIN_SIGMA=1.5
MNQ_VR_TARGET_R=4

# Shared
MNQ_MAX_STOP_POINTS=25
MNQ_MIN_STOP_POINTS=5
MNQ_STOP_BUFFER=1
MNQ_PROFIT_TARGET_R=2.5
MNQ_MIN_TARGET_POINTS=20
MNQ_MIN_CONFLUENCE=2
MNQ_MOVE_STOP_TO_BE=true
MNQ_BE_ACTIVATION_R=1.2

# ═══════════════════════════════════════════════════════════════
#  MES — Opening Range Breakout (Sweep Winner: useTrendFilter=false)
# ═══════════════════════════════════════════════════════════════
# 12m backtest: 76t, 45% WR, PF 1.42, +$911, 30% DD
MES_SYMBOL=MESH6
MES_STRATEGY=opening_range_breakout
MES_DATABENTO_SYMBOL=MES.FUT
MES_AUTO_ROLLOVER=true
MES_LAST_ENTRY_HOUR=8
MES_LAST_ENTRY_MINUTE=30

# Risk
MES_RISK_PER_TRADE_MIN=25
MES_RISK_PER_TRADE_MAX=50
MES_DAILY_LOSS_LIMIT=100
MES_WEEKLY_LOSS_LIMIT=300
MES_MAX_CONSECUTIVE_LOSSES=3
MES_MAX_DRAWDOWN_PERCENT=5

# ORB params (sweep winner config)
MES_OR_PERIOD_MINUTES=15
MES_OR_BUFFER=0.5
MES_STOP_BUFFER=0.5
MES_MAX_STOP_POINTS=15
MES_MIN_OR_RANGE=2
MES_MAX_OR_RANGE=12
MES_MIN_BODY_RATIO=0.3
MES_PROFIT_TARGET_R=2
MES_USE_TREND_FILTER=false
MES_USE_VOLUME_FILTER=true
MES_VOLUME_MIN_RATIO=1.0
MES_USE_RSI_FILTER=false
MES_USE_ADX_FILTER=false
MES_ALLOW_SHORTS=true
MES_MOVE_STOP_TO_BE=false

# ═══════════════════════════════════════════════════════════════
#  M2K — Opening Range Breakout (Sweep Winner: useVolumeFilter=false)
# ═══════════════════════════════════════════════════════════════
# 12m backtest: 108t, 55% WR, PF 2.11, +$2040, 23% DD
M2K_SYMBOL=M2KH6
M2K_STRATEGY=opening_range_breakout
M2K_DATABENTO_SYMBOL=M2K.FUT
M2K_AUTO_ROLLOVER=true
M2K_LAST_ENTRY_HOUR=8
M2K_LAST_ENTRY_MINUTE=30

# Risk
M2K_RISK_PER_TRADE_MIN=20
M2K_RISK_PER_TRADE_MAX=40
M2K_DAILY_LOSS_LIMIT=80
M2K_WEEKLY_LOSS_LIMIT=250
M2K_MAX_CONSECUTIVE_LOSSES=3
M2K_MAX_DRAWDOWN_PERCENT=5

# ORB params (sweep winner config)
M2K_OR_PERIOD_MINUTES=15
M2K_OR_BUFFER=0.5
M2K_STOP_BUFFER=0.5
M2K_MAX_STOP_POINTS=15
M2K_MIN_OR_RANGE=2
M2K_MAX_OR_RANGE=12
M2K_MIN_BODY_RATIO=0.3
M2K_PROFIT_TARGET_R=2
M2K_USE_TREND_FILTER=true
M2K_USE_VOLUME_FILTER=false
M2K_VOLUME_MIN_RATIO=1.0
M2K_USE_RSI_FILTER=false
M2K_USE_ADX_FILTER=false
M2K_ALLOW_SHORTS=true
M2K_MOVE_STOP_TO_BE=false
